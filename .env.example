# Bootstrap credential. Copy a CURRENT Wegmans refresh_token from the browser's
# successful Azure AD B2C /oauth2/v2.0/token response.
# After the first refresh, the server persists the rotated token to WEGMANS_TOKEN_FILE.
WEGMANS_REFRESH_TOKEN=

# Your selected Wegmans store. Defaults below are Burlington, MA (store 59).
WEGMANS_STORE_NUMBER=59
WEGMANS_STORE_KEY=59-BURLINGTON

# Optional: where rotated credentials are persisted. Default:
# ~/.config/wegmans-mcp/tokens.json
# WEGMANS_TOKEN_FILE=/absolute/path/to/tokens.json

# These are browser-exposed Algolia search credentials. Override if Wegmans changes them.
# WEGMANS_ALGOLIA_APP_ID=QGPPR19V8V
# WEGMANS_ALGOLIA_API_KEY=...
